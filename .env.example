# Pass these into the backend process. No secrets or paid API keys are required.
# ARENA_DOCKER_CONTEXT=colima-bot-arena
# ARENA_DATA_DIR=/absolute/path/to/private/arena-data
# ARENA_ORIGINS=https://your-own-domain.example
# ARENA_SECURE_COOKIE=1
# ARENA_SUBMISSION_COOLDOWN=300

# GitHub App (configure a real App and keep these values private).
# ARENA_GITHUB_CLIENT_ID=
# ARENA_GITHUB_CLIENT_SECRET=
# ARENA_GITHUB_CALLBACK_URL=https://your-own-domain.example/api/github/callback
# ARENA_GITHUB_APP_ID=
# ARENA_GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app-private-key.pem
# ARENA_GITHUB_WEBHOOK_SECRET=
