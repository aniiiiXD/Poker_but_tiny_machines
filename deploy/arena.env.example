# /etc/arena/arena.env — production values template (chmod 600, never commit)
# Copy to the server, fill in, leave the rest commented until needed.

ARENA_DATA_DIR=/srv/arena-data
ARENA_ORIGINS=https://YOUR-DOMAIN
ARENA_PUBLIC_URL=https://YOUR-DOMAIN
ARENA_SECURE_COOKIE=1
ARENA_SUBMISSION_COOLDOWN=300

# Transactional email (Resend / Mailgun / SES — any SMTP)
ARENA_SMTP_HOST=smtp.provider.example
ARENA_SMTP_PORT=587
ARENA_SMTP_USER=
ARENA_SMTP_PASS=
ARENA_MAIL_FROM=arena@YOUR-DOMAIN

# GitHub App (only when the GitHub submission flow goes live)
# ARENA_GITHUB_CLIENT_ID=
# ARENA_GITHUB_CLIENT_SECRET=
# ARENA_GITHUB_CALLBACK_URL=https://YOUR-DOMAIN/api/github/callback
# ARENA_GITHUB_APP_ID=
# ARENA_GITHUB_PRIVATE_KEY_PATH=/etc/arena/github-app.pem
# ARENA_GITHUB_WEBHOOK_SECRET=
# ARENA_GITHUB_INSTALL_URL=
